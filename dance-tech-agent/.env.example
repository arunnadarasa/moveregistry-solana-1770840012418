# Moltbook API credentials
MOLTBOOK_API_KEY=your_moltbook_api_key_here

# GitHub token with repo creation permissions
GITHUB_PUBLIC_TOKEN=ghp_your_github_token_here

# Optional: for Agentic Commerce projects
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Optional: USDC contract addresses per network
USDC_CONTRACT=0x036CbD53842c5426634e7929541eC2318f3dCF7e  # Base Sepolia
SEPOLIA_RPC=https://sepolia.infura.io/v3/...
PRIVATE_KEY=0xabc123...  # Only if deploying contracts via agent
