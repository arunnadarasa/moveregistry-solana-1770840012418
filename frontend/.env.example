# MoveRegistry Frontend Environment Variables

# Required for Privy wallet integration
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id_here

# Required for Solana connection
NEXT_PUBLIC_SOLANA_RPC=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=your_anchor_program_id_here

# Optional: your deployed URL for x402 callbacks
NEXT_PUBLIC_URL=https://moveregistry-solana.vercel.app