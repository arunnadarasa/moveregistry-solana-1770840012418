{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "env": {
    "NEXT_PUBLIC_SOLANA_RPC": "@solana_rpc",
    "NEXT_PUBLIC_PROGRAM_ID": "@program_id"
  }
}